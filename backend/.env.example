# PostgreSQL Database URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ats_db_replica

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Logging: LOG_LEVEL = DEBUG | INFO | WARNING | ERROR (INFO shows every step).
# LOG_FILE is optional; set a path to also write a rotating log file, e.g. logs/backend.log
LOG_LEVEL=INFO
LOG_FILE=

# Email via SMTP (ACTIVE). Nothing is sent until SMTP_HOST is set.
# Port 465 = implicit TLS; any other port (e.g. 587) = STARTTLS. The certificate is verified.
# For Gmail/Workspace, SMTP_PASSWORD must be an App Password and FROM_EMAIL the same account (or an alias).
SMTP_HOST=smtp.mailer91.com
SMTP_PORT=587
SMTP_USERNAME=emailer@atsmail.encureit.com
SMTP_PASSWORD=b4CqjWJJ0WZMeRiw
SMTP_TIMEOUT_SECONDS=15

# Brevo is NOT used right now (its code is commented out in services/email_service.py and config.py).
# Only needed again if you re-enable it:
# BREVO_API_KEY=your_brevo_api_key_here
# BREVO_TIMEOUT_SECONDS=15

# Sender / template names
FROM_EMAIL=aditi.j@encureit.co.in
FROM_NAME=Talent Acquisition
COMPANY_NAME=encureit
RECRUITER_NAME=Talent Acquisition Team

# Google Calendar / Meet (service account with domain-wide delegation)
GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json
GOOGLE_CALENDAR_ORGANIZER_EMAIL=hr@yourcompany.com
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata
GOOGLE_MEET_DURATION_MINUTES=60

# FRONTEND ENVIRONMENT CONFIGURATION (PUBLIC VITE)
# ===================================================
VITE_FASTAPI_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:3000
# VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Backend FastAPI Port
PORT=8000
